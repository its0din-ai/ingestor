host=127.0.0.1
port=8080
db_path=data/ingestor.db
# Superadmin username. The superadmin password is seeded from admin_password on
# first boot; additional users are created from the dashboard.
#
# Optional. Leave it out to keep a pre-multi-user .env working unchanged: the
# superadmin name then defaults to "admin" and password-only logins (the old
# single-admin form) are still accepted.
admin_username=admin
admin_password=CHANGE_ME
# Run the pre-multi-user behavior: one admin account, no Users view, no
# per-user storage/quota handling, no per-user API tokens, and password-only
# login. Useful when an older .env is deployed with the latest build.
# Defaults to false; single_user=true is accepted as an alias.
SINGLE_USER=false
# JWT signing key for admin sessions. Must be at least 64 bytes.
# Generate one with: openssl rand -hex 64   (deploy.sh does this automatically)
jwt_secret=
# Admin session lifetime (Go duration). "0" means no expiry.
session_ttl=24h
# Mark the session cookie Secure (HTTPS only). Disable for plain-HTTP testing.
cookie_secure=false
# Trust client-IP / base-URL headers (X-Morph-Real-Ip, CF-Connecting-IP,
# X-Forwarded-For/Proto/Host) from an upstream reverse proxy. Enable when the
# app is only reachable through nginx, Cloudflare, or a FlareProx worker so
# audit IPs and generated links reflect the real client. Leave off when clients
# can connect directly, otherwise they can spoof their logged IP.
trust_proxy_headers=false
upload_dir=uploads
max_upload_mb=2048
# write_timeout covers reading upload request bodies too; keep it long for
# multi-GiB files on slow links. "0" disables the deadline.
write_timeout=2h
# How long audit entries are kept before pruning (Go duration). "0" keeps all.
audit_retention=30d
# Bearer upload tokens: comma-separated list, each [label=]token[|RFC3339].
# Omit |expiry for an indefinite token. Example:
#   alice=REPLACE_WITH_LONG_RANDOM_1|2027-06-01T00:00:00Z, bob=REPLACE_WITH_LONG_RANDOM_2
#
# Old .env files that only define the singular `bearer_token` key keep working:
# it is used whenever bearer_tokens is empty, and its uploads stay in the
# original (unowned) upload root.
bearer_tokens=
